{
  "name": "fanding-frontend",
  "private": true,
  "scripts": {
    "test:ui": "playwright test",
    "test:ui:report": "playwright show-report .artifacts/reports/ui",
    "test:ui:update": "playwright test --update-snapshots",
    "test:ui:rwd": "node scripts/test-ui.mjs --rwd",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/tsconfig.json",
    "dev:test": "vite --mode test --host 127.0.0.1 --port 4173 --strictPort",
    "test:ui:build": "node scripts/test-ui.mjs --build",
    "test:ui:capture": "node scripts/test-ui.mjs --capture",
    "test:ui:build:report": "playwright show-report .artifacts/reports/build",
    "test:e2e:critical": "playwright test --grep @critical --ignore-snapshots",
    "test:visual": "playwright test",
    "test:smoke:build": "npm run build && npm run test:ui:build",
    "test:e2e": "playwright test --ignore-snapshots",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest --watch",
    "test:unit:ui": "vitest --ui --watch",
    "test:e2e:ui": "playwright test --ignore-snapshots --ui"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/ui": "5.0.5",
    "axe-core": "^4.14.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "immer": "11.1.21",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.0",
    "react-router": "8.4.0",
    "react-use": "^17.6.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "type": "module"
}
