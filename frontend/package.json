{
  "name": "fanding-frontend",
  "private": true,
  "scripts": {
    "test:ui": "playwright test",
    "test:ui:report": "playwright show-report playwright-report/ui",
    "test:ui:update": "playwright test --update-snapshots",
    "test:ui:rwd": "playwright test rwd.spec.js",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "dev:test": "vite --mode test --host 127.0.0.1 --port 4173 --strictPort",
    "test:ui:build": "node scripts/test-build.cjs",
    "test:ui:capture": "node scripts/capture-ui.cjs",
    "test:ui:build:report": "playwright show-report playwright-report/build"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "immer": "11.1.21",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.0",
    "react-router": "8.4.0",
    "react-use": "^17.6.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "type": "module"
}
