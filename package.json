{
  "name": "fanding-inventory-demo",
  "private": true,
  "scripts": {
    "test:ui": "playwright test",
    "test:ui:report": "playwright show-report playwright-report/ui",
    "test:ui:update": "playwright test --update-snapshots",
    "test:ui:rwd": "playwright test rwd.spec.js",
    "dev": "vite --config frontend/vite.config.ts",
    "build": "npm run typecheck && vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "typecheck": "tsc -p frontend/tsconfig.json",
    "dev:test": "vite --config frontend/vite.config.ts --mode test --port 4173 --strictPort",
    "test:ui:build": "node scripts/test-build.cjs",
    "test:ui:capture": "node scripts/capture-ui.cjs",
    "test:ui:build:report": "playwright show-report playwright-report/build"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "immer": "11.1.21",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
